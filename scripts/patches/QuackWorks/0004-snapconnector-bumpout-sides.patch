-module snapConnectBacker(offset = 0, holdingTolerance=1, anchor=CENTER, spin=0, orient=UP){
+module snapConnectBacker(offset = 0, holdingTolerance=1, bumpoutSides = [RIGHT, LEFT, FWD, BACK], anchor=CENTER, spin=0, orient=UP){
     attachable(anchor, spin, orient, size=[11.4465*2, 11.4465*2, 6.17+offset]){ 
     //bumpout profile
     bumpout = turtle([
@@ -56,7 +56,7 @@
             
