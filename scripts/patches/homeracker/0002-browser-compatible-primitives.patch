+    // to avoid coincident faces creating zero-volume scraps in CGAL plates.
+    linear_extrude(height = size.y + 0.002, center = true)
+      rect([size.x, size.z], rounding = top ? [radius, radius, 0, 0] : [0, 0, radius, radius]);
