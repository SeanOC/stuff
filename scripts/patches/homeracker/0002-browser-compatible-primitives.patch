+
+// Equivalent full-panel solid for the browser path. All measurements are
+// upstream constants; split/brace modes retain the original implementation.
+module hr_flat_rackpanel(panel_width, units, bore_mode, panel_depth, chamfer_enabled) {
+  panel_height = units * STD_UNIT_HEIGHT;
+  bore_count = get_bore_count_per_unit(bore_mode, units);
+  z_positions = bore_mode == RP_BORE_MODE_MINIMAL
+    ? (units == 1 ? [0] : [-(panel_height - STD_UNIT_HEIGHT) / 2, (panel_height - STD_UNIT_HEIGHT) / 2])
+    : [for (u = [0:units-1], b = [0:bore_count-1])
+        (u - (units-1)/2) * STD_UNIT_HEIGHT
+          + (b - (bore_count-1)/2) * STD_RACK_BORE_DISTANCE_Z * (4-bore_count)];
+  difference() {
+    cuboid([panel_width, panel_depth, panel_height],
+           chamfer = chamfer_enabled ? BASE_CHAMFER : 0, edges = FRONT);
+    for (side = [-1, 1], z = z_positions)
+      translate([side * (panel_width - STD_MOUNT_SURFACE_WIDTH) / 2, 0, z])
+        rotate([90, 0, 0])
+          linear_extrude(height = panel_depth + HR_EPSILON, center = true)
+            rect([RP_RACKMOUNT_BORE_WIDTH, RP_RACKMOUNT_BORE_HEIGHT],
+                 rounding = RP_RACKMOUNT_BORE_HEIGHT / 2);
+  }
+}
