+// Same XZ rounded profile extruded along Y; avoids BOSL2's 3D hull path
+// (degenerate Manifold facets / stalled CGAL hull in OpenSCAD wasm).
+module hr_rounded_xz_prism(size, radius, top = true) {
+  rotate([90, 0, 0])
