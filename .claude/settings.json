{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(openscad:*)",
      "Bash(xvfb-run:*)",
      "Bash(python3 .claude/skills/_lib/*.py:*)",
      "Bash(python3 .claude/skills/*/scripts/*.py:*)",
      "Bash(python3 -m pytest .claude/skills/**:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(~/.claude/projects/**)",
      "Read(**/.gc/runtime/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(sudo:*)",
      "Bash(gh pr merge --admin:*)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.prod)",
      "Read(**/*.env)"
    ]
  }
}
