{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(openscad:*)",
      "Bash(xvfb-run:*)",
      "Bash(python3 .claude/skills/_lib/*.py:*)",
      "Bash(python3 .claude/skills/*/scripts/*.py:*)",
      "Bash(python3 -m pytest .claude/skills/**:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.claude/projects/**)",
      "Read(**/.gc/runtime/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(sudo:*)",
      "Bash(gh pr merge --admin:*)"
    ]
  }
}
