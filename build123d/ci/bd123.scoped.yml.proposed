# PROPOSED bd123.yml — change-scoped fast/audit selection (bead pst-3bga4).
#
# Worker policy forbids editing .github/workflows/, so this is the full
# proposed replacement for .github/workflows/bd123.yml; activation steps are
# in build123d/ci/README.md. Changes vs main: the `changes` job checks out,
# syncs and runs build123d/scripts/select-bd-tests.py; fast and audit need it
# and skip or append -k when it scopes; the cradle filter's holders/** entry
# becomes the holder modules the sweep imports. Job names are unchanged.
#
# build123d PoC toolchain (Sean 2026-08-30). ADVISORY jobs — deliberately NOT
# required status checks while the PoC runs, and path-filtered at the workflow
# level (safe because they are not required; the required checks in ci.yml must
# never get a workflow-level filter — see the comment there).
#
# pst-24tr6 (CI P3+P4): three jobs selected by pytest marker (the contract is
# in build123d/ci/README.md and enforced by build123d/tests/conftest.py):
#   fast        everything that is not an audit, plus the serial budget step
#   audit       every registry-sized print audit except the cradle corner sweep,
#               plus the spool cradle mount contracts (registry-sized builds)
#   audit_full  the cradle corner sweep, 6 pytest-split shards; PRs that touch
#               model/audit code, every push to main, and nightly
# pst-3bga4: on pull_request, fast and audit run only what the change can
# affect (`changes` emits mode=full|scoped|skip and k_expr); push to main and
# schedule always run everything.
# A command-line -m REPLACES pyproject's addopts "-m 'not upstream'", so every
# expression below ends with "and not upstream" (PR CI stays offline —
# build123d/reference/FETCH.md).
name: bd123
on:
  pull_request:
    paths: ["build123d/**", ".github/workflows/bd123.yml"]
  push:
    branches: [main]
    paths: ["build123d/**", ".github/workflows/bd123.yml"]
  schedule:
    # Nightly full run (09:17 UTC). Failures are picked up by the mayor's
    # heartbeat (gh run list --workflow bd123 --event schedule), see
    # build123d/ci/README.md.
    - cron: '17 9 * * *'

jobs:
  fast:
    name: build123d fast
    needs: changes
    # !cancelled() so a skipped `changes` (push/schedule) or a failed one runs
    # everything: its outputs are then empty, so K_EXPR is empty too.
    if: ${{ !cancelled() && needs.changes.outputs.mode != 'skip' }}
    runs-on: ubuntu-latest
    # pst-bnya8: run 38038626797 spent 24m57s before export; allow ~50%
    # headroom on a ~26m total (export took 39s in run 38016264899).
    timeout-minutes: 40
    defaults: { run: { working-directory: build123d } }
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - name: sync env (pinned via uv.lock)
        run: uv sync --frozen --group capture
      - name: regenerate manifest (deterministic emitter)
        # The committed build123d/manifest.json must match what the
        # registry currently produces — same freshness contract as the
        # thumbnail renders in ci.yml. A stale manifest means the model
        # change forgot to run `uv run python scripts/manifest.py`.
        run: uv run python scripts/manifest.py
      - name: manifest freshness (fail on drift)
        # Note: job working-directory is build123d/, hence the relative path.
        run: git diff --exit-code manifest.json
      - name: tests (everything except audits)
        # -n 4, not auto: -n auto counts PHYSICAL cores (psutil) and picks 2 on
        # this 4-vCPU runner. Memory is not the bound (measured: import 0.5 GB,
        # serial suite 1.14 GB, cradle file <= 844 MB per xdist worker; 16 GB).
        # --dist load, not loadfile: test_spool_cradle.py must spread across
        # workers. -rf names every failure.
        env:
          K_EXPR: ${{ needs.changes.outputs.k_expr }}
        run: |
          scope=(); if [ -n "$K_EXPR" ]; then scope=(-k "$K_EXPR"); fi
          uv run pytest tests/ -q -n 4 --dist load -rf --tb=short -m "not audit and not budget and not upstream" "${scope[@]}"
      - name: audit budgets (serial)
        # The per-model audit budget is a serial CPU-time measurement, so it
        # skips under xdist (test_print_audit.py); this step is where the
        # 60 s per-model budget is enforced. pst-sx1g3: the budget times a COLD
        # audit, so the audit cache is off here (the helper also asserts it).
        env:
          BD_AUDIT_CACHE: off
          K_EXPR: ${{ needs.changes.outputs.k_expr }}
        run: |
          scope=(); if [ -n "$K_EXPR" ]; then scope=(-k "$K_EXPR"); fi
          uv run pytest tests/ -q -n 0 -rf --tb=short -m "budget and not upstream" "${scope[@]}"
      - name: export all models (STL + GLB + PNG)
        run: uv run python scripts/export.py
      - name: upload artifacts (STL/GLB/PNG + viewer)
        uses: actions/upload-artifact@v4
        with:
          name: bd123-models
          path: |
            build123d/out/
            build123d/viewer/index.html
      - name: render summary (PNGs inline)
        run: |
          echo "## build123d models" >> "$GITHUB_STEP_SUMMARY"
          echo "Download the **bd123-models** artifact for STL/GLB + the drag-drop viewer (viewer/index.html)." >> "$GITHUB_STEP_SUMMARY"
          for f in out/*.png; do echo "### $(basename "$f" .png)" >> "$GITHUB_STEP_SUMMARY"; done

  audit:
    name: build123d audit
    needs: changes
    if: ${{ !cancelled() && needs.changes.outputs.mode != 'skip' }}
    runs-on: ubuntu-latest
    # pst-hruv1: the same 164-item selection swung 18.8-32.5 min across main runs
    # 38299848019 / 38334657942 / 38377646596 before #193 and ran 34m57s clean in
    # 38432960766 (-n 4 on 2 physical cores = high variance). 45 = ~30% headroom
    # over the slowest clean run; pytest-split of this tier is a separate bead.
    # pst-t0ob3.4 (mayor carve-out): the D4 divider presets took this job to
    # 37m22s in PR #199 run 38506273980; 37.4 x 1.5 = 56 -> 60.
    # pst-dyobq (mayor carve-out): a cold cache (any PR touching print_audit.py,
    # audit_cache.py or uv.lock) took this job to 51m53s in PR #204 run
    # 38596072475; 51.9 x 1.5 = 78 -> 80.
    timeout-minutes: 80
    defaults: { run: { working-directory: build123d } }
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - name: sync env (pinned via uv.lock)
        run: uv sync --frozen
      - name: restore/save the print-audit cache
        # pst-sx1g3: content-addressed reports (build123d/tests/audit_cache.py);
        # one saver per key (run id + job), and the prefix restores any
        # earlier save — a restored entry can only add hits.
        uses: actions/cache@v4
        with:
          path: build123d/.cache/audit
          key: bd-audit-${{ hashFiles('build123d/tests/print_audit.py', 'build123d/tests/audit_cache.py', 'build123d/uv.lock') }}-${{ matrix.group || 'audit' }}-${{ github.run_id }}
          restore-keys: bd-audit-${{ hashFiles('build123d/tests/print_audit.py', 'build123d/tests/audit_cache.py', 'build123d/uv.lock') }}-${{ matrix.group || 'audit' }}-
      - name: print audits (presets, reproducers, other models)
        # pst-rir4i: one JSON row per audit item (+ measurement rows) for
        # reviewers; reader recipe in build123d/ci/README.md. A scoped PR run
        # writes rows for the selected models only.
        env:
          BD_AUDIT_OUT: out/audit/rows.jsonl
          K_EXPR: ${{ needs.changes.outputs.k_expr }}
        run: |
          scope=(); if [ -n "$K_EXPR" ]; then scope=(-k "$K_EXPR"); fi
          uv run pytest tests/ -q -n 4 --dist load -rf --tb=short -m "audit and not audit_full and not upstream" "${scope[@]}"
      - name: upload audit rows
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: bd123-audit-rows
          path: build123d/out/audit/
          retention-days: 14

  changes:
    # Decides whether a PR runs the cradle corner sweep, and the fast/audit
    # scope (pst-3bga4). pull_request only: on push to main and on schedule
    # every job runs in full. dorny/paths-filter lists the PR's files via the
    # API; the checkout + sync are for the selector, which reads the registry.
    name: detect model/audit changes
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    defaults: { run: { working-directory: build123d } }
    permissions:
      contents: read
      # paths-filter calls listFiles on the PR; without pull-requests: read the
      # call fails with "Resource not accessible by integration" (ci.yml same).
      pull-requests: read
    outputs:
      cradle: ${{ steps.filter.outputs.cradle }}
      mode: ${{ steps.select.outputs.mode }}
      k_expr: ${{ steps.select.outputs.k_expr }}
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - name: sync env (pinned via uv.lock)
        run: uv sync --frozen
      - name: Filter paths
        id: filter
        uses: dorny/paths-filter@v3
        with:
          list-files: shell
          filters: |
            any:
              - '**'
            cradle:
              # the swept holder modules, the holders modules they import
              # (tombstone_sign: label_card, sign_ghost, signs; spool_cradle:
              # label_card) and the registry + bed constants they all use
              - 'build123d/holders/cartridge_holder.py'
              - 'build123d/holders/gridfinity_capture_bin.py'
              - 'build123d/holders/label_card.py'
              - 'build123d/holders/openconnect_drawer.py'
              - 'build123d/holders/printer.py'
              - 'build123d/holders/registry.py'
              - 'build123d/holders/sign_ghost.py'
              - 'build123d/holders/signs.py'
              - 'build123d/holders/spool_cradle.py'
              - 'build123d/holders/tombstone_sign.py'
              - 'build123d/labels/**'
              - 'build123d/multibuild/**'
              - 'build123d/openconnect/**'
              - 'build123d/tests/print_audit.py'
              - 'build123d/tests/audit_cache.py'
              - 'build123d/tests/mount_contracts.py'
              - 'build123d/tests/test_spool_cradle.py'
              # capture-bin endpoint sweep lives in audit_full (pst-8vwop)
              - 'build123d/gridfinity/**'
              - 'build123d/tests/test_gridfinity_capture_bin.py'
              # drawer endpoint/corner sweep lives in audit_full (pst-t0ob3.2)
              - 'build123d/drawer/**'
              - 'build123d/tests/test_openconnect_drawer.py'
              - 'build123d/tests/test_honeycomb.py'
              - 'build123d/tests/conftest.py'
              - 'build123d/pyproject.toml'
              - 'build123d/uv.lock'
              # the other three files carrying audit_full cases
              - 'build123d/tests/test_cartridge_holder.py'
              - 'build123d/tests/test_openconnect_drawer_container.py'
              - 'build123d/tests/test_tombstone_sign.py'
      - name: Decide fast/audit scope
        id: select
        # Prints the mode and -k expression to the log and step summary. Every
        # -k term is a registry name, slug or file stem matching TERM_RE, and
        # K_EXPR reaches pytest through env, never the run: line.
        env:
          CHANGED_PATHS: ${{ steps.filter.outputs.any_files }}
        run: uv run python scripts/select-bd-tests.py --changed-paths "$CHANGED_PATHS"

  audit_full:
    name: build123d audit (full sweep)
    needs: changes
    # Fail-soft like ci.yml's render job: if `changes` failed, run the sweep.
    # !cancelled() so a skipped `changes` (push/schedule) does not skip this.
    if: ${{ !cancelled() && (github.event_name != 'pull_request' || needs.changes.result != 'success' || needs.changes.outputs.cradle == 'true') }}
    runs-on: ubuntu-latest
    # pst-2z9ng: 6 shards on main run 38444800427 (post-#190) took
    # 16m19/12m00/21m34/21m40/15m30/12m07; 21m40 x 1.5 = 32.5 -> 35 (the
    # audit job's 50% headroom rule). The floor is one case,
    # test_openconnect_drawer_container.py::test_endpoint_audit_and_edges
    # [vertical_grids=8] (672-738 s local, ~21 min CI): no rebalance lowers it.
    # pst-t0ob3.4 (mayor carve-out): D4 adds 25 divider corner rows (+108 min
    # of audit, measured into tests/.test_durations); the split simulates a
    # 22.3 min slowest shard (~26 min CI at main's 1.15x) -> 35 -> 45.
    timeout-minutes: 45
    strategy:
      fail-fast: false
      matrix:
        group: [1, 2, 3, 4, 5, 6]
    defaults: { run: { working-directory: build123d } }
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - name: sync env (pinned via uv.lock)
        run: uv sync --frozen
      - name: restore/save the print-audit cache
        # pst-sx1g3: content-addressed reports (build123d/tests/audit_cache.py);
        # one saver per key (run id + shard), and the prefix restores any
        # earlier save — a restored entry can only add hits.
        uses: actions/cache@v4
        with:
          path: build123d/.cache/audit
          key: bd-audit-${{ hashFiles('build123d/tests/print_audit.py', 'build123d/tests/audit_cache.py', 'build123d/uv.lock') }}-${{ matrix.group || 'audit' }}-${{ github.run_id }}
          restore-keys: bd-audit-${{ hashFiles('build123d/tests/print_audit.py', 'build123d/tests/audit_cache.py', 'build123d/uv.lock') }}-${{ matrix.group || 'audit' }}-
      - name: cradle corner sweep (shard ${{ matrix.group }}/6)
        # tests/.test_durations balances the shards; a stale or missing entry
        # only degrades balance (pytest-split splits evenly), never coverage.
        # Nightly re-measures this shard's durations (--clean-durations keeps
        # only its own tests) for the artifact below.
        env:
          STORE: ${{ github.event_name == 'schedule' && '--store-durations --clean-durations' || '' }}
          BD_AUDIT_OUT: out/audit/rows.jsonl
        run: >-
          uv run pytest tests/ -q -n 4 --dist load -rf --tb=short
          -m "audit_full and not upstream"
          --splits 6 --group ${{ matrix.group }} --durations-path tests/.test_durations
          $STORE
      - name: upload audit rows (shard ${{ matrix.group }}/6)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: bd123-audit-rows-${{ matrix.group }}
          path: build123d/out/audit/
          retention-days: 14
      - name: upload refreshed durations (nightly)
        if: ${{ !cancelled() && github.event_name == 'schedule' }}
        uses: actions/upload-artifact@v4
        with:
          name: bd123-test-durations-${{ matrix.group }}
          path: build123d/tests/.test_durations
          include-hidden-files: true
          if-no-files-found: error
